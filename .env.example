# LLM API — any OpenAI-compatible endpoint
LLM_BASE_URL=https://api.openai.com/v1          # or Nebius, Together, OpenRouter, Moonshot API, etc.
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-ai/DeepSeek-V3               # model identifier on your provider
# Example second model (use a base URL + key for a host that serves this id):
# LLM_MODEL=moonshotai/Kimi-K2.5
LLM_FALLBACK_MODEL=                             # optional fallback if primary model not found
# Fixed small model used for disambiguation across all main LLM runs (keeps comparison clean).
# DISAMBIG_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Optional separate endpoint/key for the disambig model (e.g. different billing account).
# If unset, falls back to LLM_BASE_URL / LLM_API_KEY.
# DISAMBIG_BASE_URL=https://api.studio.nebius.com/v1/
# DISAMBIG_API_KEY=your-disambig-api-key-here

# When multiple grid_summary__<survey>__*.csv exist, analysis scripts can pin one model/tag:
# GRID_SUMMARY_TAG=moonshotai_Kimi-K2.5

# Path to configs/local.yaml in the synthetic_sampling repo
# That file tells the loader where the survey data files live on disk
DATA_CONFIG_PATH=C:/path/to/synthetic_sampling/configs/local.yaml

# Optional: relocate the outputs/ artifact tree (default: <repo>/outputs)
# SURVEY_FEATURES_OUTPUTS=D:/survey_features_outputs

# Optional: relocate the paper/ writing workspace (default: <repo>/paper; gitignored)
# SURVEY_FEATURES_PAPER=D:/survey_features_paper

# Optional: cap XGBoost threads per classifier when running threaded grid cells (integer >= 1)
# GRID_XGB_NTHREAD=1
