# LLM API — Nebius Studio hosts the current selector / extractor / disambig catalog.
LLM_BASE_URL=https://api.studio.nebius.com/v1/
LLM_API_KEY=your-api-key-here
LLM_MODEL=moonshotai/Kimi-K2.6
LLM_FALLBACK_MODEL=

# Optional separate endpoint for extractor/disambiguator (else LLM_* is used).
# DISAMBIG_BASE_URL=https://api.studio.nebius.com/v1/
# DISAMBIG_API_KEY=your-disambig-api-key-here
# DISAMBIG_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Path to synthetic_sampling configs/local.yaml (survey microdata locations)
DATA_CONFIG_PATH=C:/path/to/synthetic_sampling/configs/local.yaml

# Artifact tree — local path to the shared Dropbox folder `features_project/outputs`.
# Real path lives in .env (gitignored). After Dropbox sync, typically:
#   .../Dropbox/features_project/outputs
SURVEY_FEATURES_OUTPUTS=/path/to/Dropbox/features_project/outputs

# Optional: writing workspace (gitignored). Default is <repo>/paper.
# SURVEY_FEATURES_PAPER=D:/survey_features_paper
